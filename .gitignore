# ---------------- 密钥与本地环境 ----------------
.env
.env.local

# ---------------- Python ----------------
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/

# ---------------- 依赖与离线包 ----------------
# 根目录 vendor/ 是手动解压的 pymupdf wheel（132MB），复原方式见 README：
#   python -m pip install pymupdf==1.26.4
# 注意只排除根目录的：web/vendor/ 里是阅读器要用的 pdf.js，必须入库。
/vendor/

# ---------------- 论文语料（体积大 + 版权，绝不提交）----------------
papers/
papers_audit/
papers_test/
*.pdf

# ---------------- 运行时数据 / 生成物（可重建）----------------
store/
out/
.tmp/
_relay/

# ---------------- Agent / 工具残留 ----------------
.box-agent/
.box-agent-scratch/
nul

# ---------------- 根目录内部文档 ----------------
# 交付说明、验收报告、识别报告、待定问题、各类 CHECK 清单都含客户/内部信息，
# 一律不进公开仓库。以后要写公开说明请新建 README.md（下面单独放行）。
/*.md
!/README.md
# 归档的历史文档（旧版本验收报告 / 识别报告 / CHECK 清单）同理，不进公开仓库
docs/archive/
# 客户/内部工作计划（含看山工作台协作信息），不进公开仓库
/docs/刘看山阅读助手计划书.md
/docs/跨页表格批量测试计划_看山工作台.md

# ---------------- 运行时临时与测试产物（可重建，不进仓库）----------------
# 浏览器/接口测试的截图与报告、临时服务副本、下载的 PDF、外部素材原图
/test-results/
/test-sandbox/
/tmp/
/KanShan/

# 界面里保存的模型配置（可能含 key，绝不进仓库）
/settings.json

# ---------------- 演示实例用的固定论文（只放 arXiv / 公开许可的 4 篇，约 4MB）----------------
# 上面的 *.pdf 会误伤，这里显式放行；demo_papers/ 是线上 Demo 的唯一语料。
!demo_papers/
!demo_papers/*.pdf
