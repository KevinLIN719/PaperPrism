# PaperPrism 模型配置（复制成 .env 后填自己的 key；.env 不进 git）
#
# DeepSeek 官方（默认）
DEEPSEEK_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 想换成任何 OpenAI 兼容的服务，只改这三行即可，例如：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 网络通道：默认直连模型接口（本机开着 Clash 等系统代理时，代理会随机掐断 TLS，
# 报 [SSL: UNEXPECTED_EOF_WHILE_READING]）。base 是境外域名、必须走代理时设成 1。
# LLM_USE_SYSTEM_PROXY=1
